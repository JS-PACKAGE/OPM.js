{
  "name": "opm.js",
  "version": "1.5.0",
  "description": "A zero-dependency four-operator FM synthesis engine",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YueyuHoshizora/OPM.js.git"
  },
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./voices/schema.js": {
      "types": "./dist/voices/schema.d.ts",
      "import": "./dist/voices/schema.js"
    },
    "./voices/normalize.js": {
      "types": "./dist/voices/normalize.d.ts",
      "import": "./dist/voices/normalize.js"
    },
    "./voices/brass.js": {
      "types": "./dist/voices/brass.d.ts",
      "import": "./dist/voices/brass.js"
    },
    "./voices/dx7.js": {
      "types": "./dist/voices/dx7.d.ts",
      "import": "./dist/voices/dx7.js"
    },
    "./voices/*.js": {
      "types": "./dist/voices/*.d.ts",
      "import": "./dist/voices/*.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "doc/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.dev.json",
    "test": "npm run compile && node .dev/scripts/test.js",
    "benchmark": "npm run compile && node .dev/scripts/benchmark.js",
    "sound-quality": "npm run compile && node .dev/scripts/sound-quality.js",
    "voice-quality": "npm run compile && node .dev/scripts/voice-quality.js",
    "browser-stress": "npm run compile && node .dev/scripts/browser-stress.js",
    "vite-smoke": "npm run compile && node .dev/scripts/vite-smoke.js",
    "build": "npm run compile && node .dev/scripts/build.js",
    "security": "npm run compile && node .dev/scripts/security-check.js",
    "browser-smoke": "npm run compile && node .dev/scripts/browser-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM scripts/types/public-api.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  }
}
