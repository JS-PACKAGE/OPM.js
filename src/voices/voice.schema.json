{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPM.js canonical voice v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "algorithm",
    "feedback",
    "modIndex",
    "lfo",
    "ops"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "algorithm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "feedback": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "modIndex": {
      "type": "number",
      "minimum": 0,
      "maximum": 16
    },
    "lfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rate",
        "amDepth",
        "pmDepth"
      ],
      "properties": {
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "amDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pmDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1200
        }
      }
    },
    "ops": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ratio",
          "level",
          "detune",
          "adsr"
        ],
        "properties": {
          "keyScale": {
            "type": "object",
            "additionalProperties": false,
            "required": ["breakpoint", "leftDbPerOctave", "rightDbPerOctave"],
            "properties": {
              "breakpoint": { "type": "integer", "minimum": 0, "maximum": 127 },
              "leftDbPerOctave": { "type": "number", "minimum": 0, "maximum": 24 },
              "rightDbPerOctave": { "type": "number", "minimum": 0, "maximum": 24 }
            }
          },
          "ratio": {
            "type": "number",
            "minimum": 0.125,
            "maximum": 32
          },
          "level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "detune": {
            "type": "number",
            "minimum": -1200,
            "maximum": 1200
          },
          "adsr": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "d",
              "s",
              "r"
            ],
            "properties": {
              "a": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "d": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "s": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "r": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        }
      }
    }
  }
}
