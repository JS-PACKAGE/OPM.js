{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
