{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": ".dev",
    "declaration": false,
    "emitDeclarationOnly": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "demo/**/*.ts"],
  "exclude": ["dist", "node_modules", ".dev", "scripts/types"]
}
